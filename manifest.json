{
  "manifest_version": 3,
  "name": "Reels Scrubber",
  "version": "1.4.2",
  "description": "Seek bar, speed control, and a frame strip for videos on Instagram, TikTok, and Facebook.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
